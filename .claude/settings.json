{
  "enabledPlugins": {},
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "gw guard --tool-input -",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "gw _claude-worktree-create",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "gw _claude-worktree-remove",
            "type": "command"
          }
        ]
      }
    ]
  }
}
